{
  "openapi": "3.1.1",
  "info": {
    "title": "Home API",
    "version": "v1"
  },
  "paths": {
    "/api/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Reports whether the API and its dependencies are healthy.",
        "operationId": "getSystemStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses": {
      "get": {
        "tags": [
          "Expenses"
        ],
        "summary": "Lists one month's expenses, newest first, with the month's total.",
        "operationId": "listExpenses",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "payer",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Payer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExpenseList"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses/incomes": {
      "get": {
        "tags": [
          "Expenses"
        ],
        "summary": "Lists one month's incomes, newest first, with the month's total.",
        "operationId": "listIncomes",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "person",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Person"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncomeList"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses/categories": {
      "get": {
        "tags": [
          "Expenses"
        ],
        "summary": "Lists the expense categories in display order.",
        "operationId": "listExpenseCategories",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryItem": {
        "required": [
          "id",
          "name",
          "sortOrder"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "A category as lists and pickers show it."
      },
      "ExpenseItem": {
        "required": [
          "id",
          "date",
          "payer",
          "categoryId",
          "categoryName",
          "amount",
          "paymentMethod",
          "comment"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "payer": {
            "$ref": "#/components/schemas/Payer"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryName": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "comment": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "One expense row of the month list, with its category name."
      },
      "ExpenseList": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalAmount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseItem"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalAmount": {
            "type": "number",
            "format": "double"
          }
        },
        "description": "One page of a month's expenses, plus the sum of every expense that matches the filter (not just this page)."
      },
      "HealthStatus": {
        "enum": [
          "Unhealthy",
          "Degraded",
          "Healthy"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IncomeItem": {
        "required": [
          "id",
          "date",
          "person",
          "amount",
          "comment"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "person": {
            "$ref": "#/components/schemas/Person"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "comment": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "One income row of the month list."
      },
      "IncomeList": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalAmount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IncomeItem"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalAmount": {
            "type": "number",
            "format": "double"
          }
        },
        "description": "One page of a month's incomes, plus the sum of every income that matches the filter."
      },
      "Payer": {
        "enum": [
          "Vitaliy",
          "Maria",
          "Shared"
        ],
        "description": "Who an expense is booked to (the sheet's «Кто» column): one of the two people, or the household as a whole for\nshared spending such as groceries."
      },
      "PaymentMethod": {
        "enum": [
          "Card",
          "Cash"
        ],
        "description": "How an expense was paid (the sheet's «Оплата» column)."
      },
      "Person": {
        "enum": [
          "Vitaliy",
          "Maria"
        ],
        "description": "One of the two people the household accounts belong to. Incomes always belong to one of them."
      },
      "SystemStatus": {
        "required": [
          "status",
          "version",
          "environment",
          "checks"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthStatus"
            }
          }
        },
        "description": "The overall status, the build version with its commit, the environment, and the status of each check."
      }
    }
  },
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Expenses"
    }
  ]
}