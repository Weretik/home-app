{
  "openapi": "3.1.1",
  "info": {
    "title": "Home API",
    "version": "v1"
  },
  "paths": {
    "/api/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Reports whether the API and its dependencies are healthy.",
        "operationId": "getSystemStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthStatus": {
        "enum": [
          "Unhealthy",
          "Degraded",
          "Healthy"
        ]
      },
      "SystemStatus": {
        "required": [
          "status",
          "version",
          "environment",
          "checks"
        ],
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthStatus"
            }
          }
        },
        "description": "The overall status, the build version with its commit, the environment, and the status of each check."
      }
    }
  },
  "tags": [
    {
      "name": "System"
    }
  ]
}