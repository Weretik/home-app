    "/api/system/status": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Reports whether the API and its dependencies are healthy.",
        "operationId": "getSystemStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/expenses": {
      "get": {
        "tags": [
          "Expenses"
        ],
        "summary": "Lists one month's expenses, newest first, with the month's total.",
        "operationId": "listExpenses",
