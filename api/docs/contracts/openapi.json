  "components": {
    "schemas": {
      "CategoryItem": {
        "required": [
          "id",
          "name",
          "sortOrder"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "A category as lists and pickers show it."
      },
      "CreatedEntry": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "description": "The id of a created expense, income or savings movement."
      },
      "ExpenseItem": {
        "required": [
          "id",
          "version",
          "date",
          "payer",
          "categoryId",
          "categoryName",
          "amount",
          "paymentMethod",
          "comment"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "format": "uint32"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "payer": {
            "$ref": "#/components/schemas/Payer"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "categoryName": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "comment": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "One expense row of the month list, with its category name."
      },
      "ExpenseList": {
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount",
          "totalAmount"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpenseItem"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "totalAmount": {
            "type": "number",
            "format": "double"
          }
        },
        "description": "One page of a month's expenses, plus the sum of every expense that matches the filter (not just this page)."
      },
      "ExpenseRequest": {
        "required": [
          "date",
          "payer",
          "categoryId",
          "amount",
          "paymentMethod",
          "comment"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "payer": {
            "$ref": "#/components/schemas/Payer"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "format": "double"
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "comment": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "HealthStatus": {
        "enum": [
          "Unhealthy",
          "Degraded",
          "Healthy"
        ]
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
