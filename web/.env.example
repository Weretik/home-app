# Copy to .env.local. The API origin, without a trailing slash. Not a secret: it ends up in the built JS.
VITE_API_URL=http://localhost:5000
# The Google OAuth client id for «Sign in with Google» (web ADR 0015). Public, not a secret: Google shows it in every
# sign-in page. Without it the sign-in screen says sign-in is not set up.
VITE_GOOGLE_CLIENT_ID=
